<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the Companion's connect dialog body OUTSIDE the game.

       The layout is plain string work, so there is no reason it should only be visible by
       shipping a build and photographing a screen. That is how the overflowing version got
       released: the body drew over the header and under the buttons, and no test could see it
       because the only way to produce the text was to be inside Unity.

       This loads the BUILT PhValheimCompanion.dll and reflects the real
       ConnectDialog.BuildBodyText, so what it prints is what players get. It is not a copy of
       the formatting logic; a copy would agree with itself and prove nothing.

       NOTE: no double hyphen anywhere in this comment. XML forbids it inside a comment, and
       MSBuild fails the whole project file with MSB4025 rather than warning. Same trap that
       shipped an undrawable SVG icon in 2.51. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>renderDialog</AssemblyName>
    <RootNamespace>RenderDialog</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

</Project>
