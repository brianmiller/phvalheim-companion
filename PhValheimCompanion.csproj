<Project Sdk="Microsoft.NET.Sdk">

  <!-- 2.53 rebuild.
       The original project file was a legacy (non-SDK) MSBuild project whose every HintPath
       was an absolute Windows path into a Steam install and a roaming PhValheim world
       directory. None of those resolve on a build host, so the mod could only ever be built
       on one particular Windows desktop.

       References now resolve from ./libs, which mirrors the layout phvalheim-tickmonitor and
       thorskist already use on this box. Populate it with ./refresh-libs.sh. -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>PhValheimCompanion</AssemblyName>
    <RootNamespace>PhValheimCompanion</RootNamespace>
    <Authors>posixone</Authors>
    <Version>1.0.4</Version>
    <Description>Connects PhValheim client and server events to the PhValheim backend</Description>
    <LangVersion>8.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Compile set is explicit, not globbed.
       The 2.53 rewrite removes the upstream valheim-discord-notifier code this was forked
       from, and an implicit glob would silently pull a deleted-but-not-yet-removed file back
       into the build. Listing them means the compile set is reviewable in a diff. -->
  <ItemGroup>
    <Compile Include="Main.cs" />
    <Compile Include="HungHeads.cs" />
    <Compile Include="phvalheim-backend.cs" />
    <Compile Include="Utils.cs" />
    <Compile Include="LaunchPayload.cs" />
    <Compile Include="ClientManifest.cs" />
    <Compile Include="ConnectDialog.cs" />
    <Compile Include="ModListView.cs" />
    <Compile Include="ConnectFlow.cs" />
    <Compile Include="JoinSentry.cs" />
    <Compile Include="Patches/FejdStartupPatch.cs" />
    <Compile Include="Properties/AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Referenced explicitly because the type is forwarded on net472 and does not come in
       with the framework reference alone. Utils.PostPhValheimBackendMessage needs it. -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- BepInEx + Harmony -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>libs/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>libs/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Valheim.
       assembly_valheim_publicized is the PUBLICIZED assembly. It is what lets this compile
       against private members such as ItemStand.m_supportedItems. It also compiles green and
       throws at runtime if a member was private for a reason, so a successful build here is
       NOT evidence the mod works. A real client smoke test is the only oracle. -->
  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>libs/assembly_valheim_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>libs/assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>libs/assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Splatform">
      <HintPath>libs/Splatform.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>libs/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>libs/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>libs/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>libs/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>libs/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>libs/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>libs/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>libs/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>libs/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>libs/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>libs/netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
